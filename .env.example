# Settings for docker compose. Copy to .env and fill in.

# The public address of the Piggyback service (an A record pointing at this server).
PIGGYBACK_DOMAIN=feet.example.com

# Encrypts foot templates. Generate once with `openssl rand -base64 32` and keep a copy somewhere safe:
# lose it and every enrolled user has to enroll again.
PIGGYBACK_DATA_KEY=

# Demos only: lets the identity-platform flows use drawn sample feet. Leave empty in production.
PIGGYBACK_ALLOW_SAMPLE=

# Optional example app (docker compose --profile demo up -d). Uncomment CADDYFILE so Caddy serves it too, and register it first:
#   docker compose exec piggyback piggyback add-client --name "Piggy Bank" --redirect-uri https://demo.example.com/mfa/callback
# CADDYFILE=./deploy/Caddyfile.docker-demo
DEMO_DOMAIN=demo.example.com
DEMO_CLIENT_ID=
DEMO_CLIENT_SECRET=
