# Settings for the optional "Piggy Bank" example app (password + feet). Copy to /etc/piggyback/demo-app.env
# (owner root, group piggyback, mode 640). Get CLIENT_ID and CLIENT_SECRET from:
#   sudo -u piggyback /opt/piggyback/app/deploy/pb add-client --name "Piggy Bank" --redirect-uri https://demo.example.com/mfa/callback
PORT=3000
APP_URL=https://demo.example.com
FEET_URL=https://feet.example.com
CLIENT_ID=
CLIENT_SECRET=
