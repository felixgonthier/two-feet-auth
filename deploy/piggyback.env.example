# Settings for the Piggyback service. Copy to /etc/piggyback/piggyback.env (owner root, group piggyback, mode 640).
# The service reads this through systemd; deploy/pb reads it for admin commands.

# Where the service listens. Caddy (or your proxy) forwards https traffic here.
PORT=8787

# The https address people and apps reach it at. Phones open links on it, so it must be public.
PUBLIC_URL=https://feet.example.com

# Registered apps, signing keys and encrypted foot templates live here. Back it up.
DATA_DIR=/var/lib/piggyback

# Encrypts foot templates. Generate once with `openssl rand -base64 32` and keep a copy somewhere safe:
# lose it and every enrolled user has to enroll again.
PIGGYBACK_DATA_KEY=

# Optional: share sessions and phone links between several instances (Redis 6.2+, rediss:// for TLS).
# PIGGYBACK_REDIS_URL=redis://localhost:6379

# Tester mode (?tester) keeps testers' scans, encrypted, for 30 days. "off" refuses them; an admin key lets
# GET /v1/admin/tester-scans export them (generate with `openssl rand -base64 32`).
# PIGGYBACK_TESTER=off
# PIGGYBACK_ADMIN_KEY=

# Demos only: lets the identity-platform flows use drawn sample feet (?pb_sample=you). Leave unset in production.
# PIGGYBACK_ALLOW_SAMPLE=1
